{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Mintlify Starter Kit",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Build with Northstar",
            "pages": [
              "guides/authentication",
              "guides/customer-onboarding",
              "guides/event-tracking",
              "guides/usage-analytics",
              "guides/pagination",
              "guides/webhooks",
              "guides/troubleshooting"
            ]
          },
          {
            "group": "Updates",
            "pages": [
              "changelog"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.yaml",
        "groups": [
          {
            "group": "Customers",
            "pages": [
              "GET /customers",
              "POST /customers",
              "GET /customers/{customer_id}",
              "PATCH /customers/{customer_id}"
            ]
          },
          {
            "group": "Events",
            "pages": [
              "GET /events",
              "POST /events"
            ]
          },
          {
            "group": "Analytics",
            "pages": [
              "GET /usage/summary"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "GET /webhooks",
              "POST /webhooks",
              "GET /webhooks/{webhook_id}",
              "DELETE /webhooks/{webhook_id}"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "icons": {
    "library": "lucide"
  }
}
